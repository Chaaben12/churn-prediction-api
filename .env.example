# Copy to `.env` next to docker-compose.yml (compose loads it automatically).
# Every variable is optional; defaults shown below apply when unset.

CHURN_ENVIRONMENT=local
CHURN_LOG_LEVEL=INFO
CHURN_DECISION_THRESHOLD=0.5

# Override only if you mount a different model location:
# CHURN_MODEL_PATH=/app/models/churn_classifier_v0.1.0.joblib
# CHURN_MODEL_METADATA_PATH=/app/models/churn_classifier_v0.1.0_metrics.json
