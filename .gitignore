# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Environment / secrets - never commit
.env
.env.*
!.env.example

# Datasets - never commit (see scripts/download_data.sh)
training/data/*
!training/data/.gitkeep

# Model artifacts and their metric reports - ignored by default;
# blessed production versions are whitelisted below (see models/README.md)
models/*.joblib
models/*.pkl
models/*.json
!models/churn_classifier_v0.1.0.joblib
!models/churn_classifier_v0.1.0_metrics.json

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
